# ── Local dev (docker-compose) ────────────────────────────────────────────────
POSTGRES_USER=pokerledger
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pokerledger

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pokerledger:changeme@postgres:5432/pokerledger
JWT_SECRET=supersecretkey_changeme_min32chars

# ── Frontend ──────────────────────────────────────────────────────────────────
# En producción apuntar a la URL pública del backend en Railway
VITE_API_URL=http://localhost:8000

# ── Railway (prod) ────────────────────────────────────────────────────────────
# Estas variables se configuran directamente en el dashboard de Railway:
# DATABASE_URL  → Provisto automáticamente por el plugin PostgreSQL
# JWT_SECRET    → Generar con: openssl rand -hex 32
# VITE_API_URL  → URL pública del servicio backend en Railway
